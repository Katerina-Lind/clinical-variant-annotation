manifest {
    name = 'clinical-variant-annotation'
    version = '0.2.0'
    description = 'Research clinical annotation of germline variants'
}

params {
    proband = null
    mother = null
    father = null
    sample_name = null

    vcf = null
    vcf_index = null

    fasta = null
    fai = null

    cache = null

    clinvar = null
    clinvar_index = null

    region = null
    outdir = 'results'

    vep_release = '116'
    vep_image = 'ensemblorg/ensembl-vep:release_116.0'
    bcftools_image = 'quay.io/biocontainers/bcftools:1.22--h3a4d415_1'

    vep_extra = ''
}

process {
    errorStrategy = 'terminate'

    withName: PREPARE {
        cpus = 4
        memory = '12 GB'
        time = '8h'
    }

    withName: ANNOTATE {
        cpus = 8
        memory = '48 GB'
        time = '48h'
    }

    withName: QC {
        cpus = 2
        memory = '8 GB'
        time = '8h'
    }
}

profiles {
    local {
        docker.enabled = true
        process.executor = 'local'
    }

    aws {
        docker.enabled = true
        process.executor = 'awsbatch'
        aws.region = 'us-east-1'
    }
}

trace.enabled = true
report.enabled = true
timeline.enabled = true
